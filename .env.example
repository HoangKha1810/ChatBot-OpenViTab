# Stable GPU preset for the Vietnamese TableQA demo.
# Usage on Ubuntu/VPS:
#   cp .env.example .env
#   set -a; source .env; set +a
#   python3 scripts/run_gpu_demo.py

TABLEQA_USE_MODELS=1
TABLEQA_REQUIRE_MODELS=1
TABLEQA_REQUIRE_GPU=1
TABLEQA_STARTUP_CHECKS=1
# 0 = demo-friendly: warm-up errors are warnings; 1 = fail startup on warm-up errors.
TABLEQA_STRICT_WARMUP=0
# auto detects V100 and disables Flash Attention. Use v100 or rtx3090 to force.
TABLEQA_GPU_PROFILE=auto

# Task models. These are intentionally stable for 24GB VRAM.
# `nomic-embed-text` is used by default because it is lightweight and avoids
# occasional Ollama 500 errors seen with bge-m3 on some RTX 3090 containers.
TABLEQA_SCHEMA_EMBED_MODEL=nomic-embed-text
TABLEQA_SCHEMA_EMBED_FALLBACK_MODEL=nomic-embed-text
TABLEQA_TEXT_TO_SQL_MODEL=qwen2.5-coder:14b
TABLEQA_ANSWER_MODEL=qwen2.5:7b
TABLEQA_VERIFIER_MODEL=qwen2.5:7b

# Ollama request options. These defaults give the Vietnamese answer model more
# room for schema, plan, and evidence context; run_gpu_demo.py raises them for
# RTX 3090/A5000 automatically.
TABLEQA_NUM_CTX=4096
TABLEQA_NUM_PREDICT=384
TABLEQA_TOP_P=0.75
TABLEQA_TEMPERATURE=0
TABLEQA_OLLAMA_KEEP_ALIVE=3m
OLLAMA_TIMEOUT_SECONDS=300

# Ollama server options for 24GB VRAM stability.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=3m
OLLAMA_KV_CACHE_TYPE=f16
OLLAMA_FLASH_ATTENTION=0

OLLAMA_BASE_URL=http://127.0.0.1:11434
